# Google Sheet published to the web as CSV. Read only.
#
# In the sheet: File > Share > Publish to web > pick the single TAB (not
# "Entire document") > Comma separated values (.csv) > Publish. Copy the
# address it gives you. It looks like this, with a /d/e/2PACX- id that is not
# the same as the id in the address bar:
#
#   https://docs.google.com/spreadsheets/d/e/2PACX-1vAbC.../pub?gid=0&single=true&output=csv
#
# The export form also works if the sheet is shared as "anyone with the link
# can view", and it does not need publishing:
#
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=<TAB_GID>
#
SHEET_CSV_URL=

# Server side only. Never exposed to the browser.
ANTHROPIC_API_KEY=

# Postgres. Vercel Postgres (Neon) in production, local Postgres or a Neon dev branch for npm run dev.
DATABASE_URL=
